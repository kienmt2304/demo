{
  "include": [
    "app/**/*",
    "public/**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*",
    "app/@types/i18next.d.ts",
    "script/**/*",
    "modules/**/*"
  ],
  "exclude": ["node_modules/**/*", ".codegraph/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "#components/*": ["./modules/ide/src/components/*"],
      "#hooks/*": ["./modules/ide/src/hooks/*"],
      "#service/*": ["./modules/ide/src/service/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
